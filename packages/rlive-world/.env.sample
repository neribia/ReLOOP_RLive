# rlive-world Environment Configuration
# ============================================================================
# How to use this file:
# - Uncomment variables to override default values from the configuration.
# - If a variable is not needed, leave it commented out to use the default value.
# - Variables are type hinted for clarity.
# ============================================================================

# ==========================================================================
# Server Configuration
# ==========================================================================

# Host address for the world server (string)
# WORLD_HOST=0.0.0.0

# Port for the world server (integer)
# WORLD_PORT=8000

# ==========================================================================
# Camera Configuration
# ==========================================================================

# Default camera type: 'dummy', 'webcam', or 'picam' (string)
# DEFAULT_CAMERA_TYPE=dummy

# Camera ID (integer)
# CAMERA_ID=0

# Camera resolution (integer)
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480

# Camera exposure time in milliseconds (integer)
# CAMERA_EXPOSURE_TIME_MS=20

# ==========================================================================
# Sphero Bolt+ Configuration (for real hardware)
# ==========================================================================

# Default robot name to connect to (string)
# - For dummy: "DummyBolt"
# - For real hardware: Your Sphero's Bluetooth name (e.g., "BP-D217")
# SPHEROBOLTPLUS_NAME=DummyBolt

# Robot speed (-255 to 255) (integer)
# SPHEROBOLTPLUS_SPEED=100

# Movement duration in seconds (float)
# SPHEROBOLTPLUS_DURATION=1.0

# ==========================================================================
# Logging Configuration
# ==========================================================================

# Log level: DEBUG, INFO, WARNING, ERROR (string)
# LOGGING_LEVEL=INFO

# Log format: simple, detailed, json (string)
# LOGGING_FORMAT=detailed

# Date style for logs: short, long, iso (string)
# LOGGING_DATE=long

# Stream logs to console: true/false (boolean)
# LOGGING_STREAM=true

# Logging to file: true/false (boolean)
# LOGGING_TO_FILE=false

# Logging file path (string)
# LOGGINF_FILE_PATH="./logs"

# Logging file name (string)
# LOGGING_FILE_NAME="rlive-world.log"

# ==========================================================================
# Debug Mode
# ==========================================================================

# Enable debug mode: true/false (boolean)
# DEBUG=true
