# rlive-env Environment Configuration
# ============================================================================
# How to use this file:
# - Uncomment variables to override default values from the configuration.
# - If a variable is not needed, leave it commented out to use the default value.
# - Variables are type hinted for clarity.
# ============================================================================

# ==========================================================================
# Client Configuration (rlive-env)
# ==========================================================================

# Base URL for the world server (string)
# WORLD_BASE_URL=http://localhost:8000

# Timeout for requests to the world server (in seconds) (integer)
# WORLD_INTERFACE_TIMEOUT=30

# Maximum number of retry attempts for requests (integer)
# WORLD_INTERFACE_MAX_RETRIES=3

# Backoff factor for retries (multiplier for delay between retries) (float)
# WORLD_INTERFACE_BACKOFF_FACTOR=0.5

# Maximum total retry time (in seconds) (integer)
# WORLD_INTERFACE_MAX_RETRIES_TIME=60

# ==========================================================================
# Goal settings (rlive-env)
# ==========================================================================

# Radius around the center point to consider as goal reached (in pixels) (integer)
# GOAL_RADIUS=50

# Colour of the goal circle in RGB format (tuple of three integers) # FIXME: Does not work in .env files
# GOAL_COLOUR=(0, 255, 0)

# Alpha value of the goal circle overlay (0.0 = invisible, 1.0 = fully visible) (float)
# GOAL_ALPHA=0.5

# ==========================================================================
# Logging Configuration
# ==========================================================================

# Log level: DEBUG, INFO, WARNING, ERROR (string)
# LOGGING_LEVEL=INFO

# Log format: simple, detailed, json (string)
# LOGGING_FORMAT=detailed

# Date style for logs: short, long, iso (string)
# LOGGING_DATE=long

# Stream logs to console: true/false (boolean)
# LOGGING_STREAM=true

# Logging to file: true/false (boolean)
# LOGGING_TO_FILE=false

# Logging file path (string)
# LOGGING_FILE_PATH="./logs"

# Logging file name (string)
# LOGGING_FILE_NAME="rlive-env.log"

# ==========================================================================
# Debug Mode
# ==========================================================================

# Enable debug mode: true/false (boolean)
# DEBUG=true
